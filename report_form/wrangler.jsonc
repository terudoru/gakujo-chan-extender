{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gakujo-report",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Include assets as well as HTML/API so every response gets security headers.
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gakujo-reports",
    // Add database_id from `wrangler d1 create` before deploying.
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://gakujo-report.terudoru.com",
    "ISSUE_REPO": "terudoru/gakujo-chan-extender",
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "gakujo-report.terudoru.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "REPORT_RETENTION_DAYS": "180"
  }
}
