import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import vm from 'node:vm';

const source = (await readFile(process.argv[2] || 'web_scripts/src/popup_relay/main.ts', 'utf8'))
  .replace('export {};', '');
const top: any = {messages: [], postMessage(...args: any[]) { this.messages.push(args); }};
const opener: any = {top, messages: [], postMessage(...args: any[]) { this.messages.push(args); }};
const window: any = {opener, messages: [], addEventListener(_name: string, fn: any) { this.listener = fn; },
  postMessage(...args: any[]) { this.messages.push(args); }};
window.parent = window;
vm.runInNewContext(source, {window, ArrayBuffer});
const title = {type: 'mbg-preview-title', name: 'sample.pdf', extra: 'ignored'};
window.listener({source: {}, data: title});
window.listener({source: opener, data: {...title, name: 3}});
assert.equal(window.messages.length, 0);
window.listener({source: opener, data: title});
assert.equal(window.messages.length, 1);
assert.notEqual(window.messages[0][0], title);
assert.equal(window.messages[0][0].type, title.type);
assert.equal(window.messages[0][0].name, title.name);
assert.equal(window.messages[0][0].extra, undefined);
const bytes = new ArrayBuffer(4);
window.listener({source: opener, data: bytes});
assert.equal(window.messages[1][0], bytes);
// The app's page script runs in the opener's top frame.
const fromTop = new ArrayBuffer(2);
window.listener({source: top, data: fromTop});
assert.equal(window.messages[2][0], fromTop);
window.listener({source: {top}, data: new ArrayBuffer(1)});
assert.equal(window.messages.length, 3);
const image = {type: 'mbg-preview-image', data: new ArrayBuffer(8), mime: 'image/png', extra: true};
window.listener({source: {}, data: image});
window.listener({source: opener, data: {...image, mime: 'image/svg+xml'}});
window.listener({source: opener, data: {...image, data: new ArrayBuffer(0)}});
window.listener({source: opener, data: {...image, data: new ArrayBuffer(64 * 1024 * 1024 + 1)}});
assert.equal(window.messages.length, 3);
window.listener({source: top, data: image});
assert.notEqual(window.messages[3][0], image);
assert.equal(window.messages[3][0].extra, undefined);
assert.equal(window.messages[3][0].mime, 'image/png');
assert.equal(window.messages[3][2][0], image.data);
const text = {type: 'mbg-preview-text', text: 'hello', note: 'notice', extra: true};
window.listener({source: opener, data: {...text, note: 3}});
window.listener({source: opener, data: {...text, text: 'x'.repeat(4000001)}});
assert.equal(window.messages.length, 4);
window.listener({source: opener, data: text});
assert.notEqual(window.messages[4][0], text);
assert.equal(window.messages[4][0].extra, undefined);
assert.equal(window.messages[4][0].note, 'notice');
window.listener({source: window, data: 'mbg-preview-close'});
assert.equal(opener.messages[0][0], 'mbg-preview-close');
console.log('Popup relay restricts titles and PDF bytes to the opener and its top window.');
